{
  "extends": ["../../tsconfig.package.json"],
  "compilerOptions": {
    "declarationDir": "./dist/types",
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": ".",
    "typeRoots": ["./types", "./node_modules/@types", "../../node_modules/@types"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "paths": {
      "three": ["three/webgpu"]
    }
  },
  "include": ["src", "types"],
  "exclude": ["node_modules/", "test/", "dist/"]
}
